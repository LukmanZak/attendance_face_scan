<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_face_scan" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.face.scan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']/block[@name='attendance_settings']" position="after">
                <block title="Face Recognition" name="face_scan_settings">
                    <setting
                        string="Minimum Face Similarity"
                        help="A face is accepted only when its cosine similarity reaches this value. The initial SFace reference is 0.363.">
                        <field name="face_scan_match_threshold"/>
                    </setting>
                    <setting
                        string="Minimum Candidate Gap"
                        help="Reject a scan when the best and second-best employee scores are closer than this gap.">
                        <field name="face_scan_ambiguity_margin"/>
                    </setting>
                    <setting
                        string="Employee Face Index"
                        help="Rebuild embeddings from active employees' profile photos.">
                        <button
                            name="action_rebuild_face_scan_index"
                            type="object"
                            string="Rebuild Index"
                            class="btn btn-secondary"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
