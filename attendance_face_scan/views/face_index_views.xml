<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_face_scan_index_tree" model="ir.ui.view">
        <field name="name">hr.employee.face.scan.index.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Employee Face Index" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <field name="active"/>
                <field name="face_scan_index_status"/>
                <field name="face_scan_indexed_at"/>
                <field name="face_scan_index_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_face_scan_index_search" model="ir.ui.view">
        <field name="name">hr.employee.face.scan.index.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Employee Face Index">
                <field name="name"/>
                <field name="department_id"/>
                <filter
                    string="Needs Attention"
                    name="needs_attention"
                    domain="[('face_scan_index_status', 'not in', ['indexed', 'archived'])]"/>
                <filter
                    string="Indexed"
                    name="indexed"
                    domain="[('face_scan_index_status', '=', 'indexed')]"/>
                <group>
                    <filter
                        string="Index Status"
                        name="group_by_status"
                        context="{'group_by': 'face_scan_index_status'}"/>
                    <filter
                        string="Company"
                        name="group_by_company"
                        context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_face_scan_index" model="ir.actions.act_window">
        <field name="name">Face Index</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_employee_face_scan_index_tree"/>
        <field name="search_view_id" ref="hr_employee_face_scan_index_search"/>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem
        id="menu_hr_employee_face_scan_index"
        name="Face Index"
        parent="hr_attendance.menu_hr_attendance_configuration"
        action="action_hr_employee_face_scan_index"
        sequence="25"
        groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
